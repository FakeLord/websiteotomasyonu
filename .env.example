# Bulut (Supabase Cloud): Project URL ve "publishable" anahtar (sb_publishable_...).
# Yerel gelistirme: supabase start ciktisindaki http://127.0.0.1:54321 ve anon anahtar.
# Gizli anahtari (sb_secret_... / service_role) BURAYA YAZMAYIN; istemciye girmez.
# Adres degisirse baslat.cmd arayuzu otomatik yeniden derler.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# İsteğe bağlı — web modu (apps/local-server, ADR 0009). Sır içermez.
# LBF_PORT=5174
