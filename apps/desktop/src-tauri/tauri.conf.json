{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Business Finder",
  "version": "0.1.1",
  "identifier": "com.hostlysisletme.localbusinessfinder",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Global Business Finder",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data: https://tile.openstreetmap.org; connect-src 'self' https: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwQTEzRkM3RUIzMzczOTMKUldTVGN6UHJ4eitoNExJUTBJcEREWU5kcFJXa2pnWDJHYmRxcVRmcUJzY1MvaFQvY1Q2K3o1eUYK",
      "endpoints": [
        "https://lmnkvloucuofozxwroug.supabase.co/storage/v1/object/public/app-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
