{
  "name": "local-business-finder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @lbf/desktop tauri dev",
    "dev:web": "node scripts/dev-web.mjs",
    "web": "pnpm --filter @lbf/desktop build && pnpm --filter @lbf/local-server start",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:db": "supabase test db",
    "sync:edge": "node scripts/sync-edge-shared.mjs",
    "test:edge": "npx -y deno@2 test --no-config --no-lock supabase/functions",
    "tauri": "pnpm --filter @lbf/desktop tauri"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "supabase": "^2.118.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.4"
  }
}
